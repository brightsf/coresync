{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://b2bcrm/contracts/satellite/v4/product.schema.json",
  "title": "Satellite product NDJSON line (v4)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "external_id",
    "hash",
    "data"
  ],
  "properties": {
    "external_id": {
      "type": "string"
    },
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "slug",
        "visible",
        "brand_external_id",
        "categories",
        "description_html",
        "seo",
        "images",
        "feature_values",
        "variants",
        "translations",
        "documents"
      ],
      "if": {
        "properties": {
          "variants": { "contains": { "required": ["price_action"] } }
        }
      },
      "then": {
        "required": ["source_identity"],
        "properties": {
          "source_identity": { "type": "object" },
          "variants": {
            "items": {
              "required": ["source_identity"],
              "properties": {
                "source_identity": { "type": "object" }
              }
            }
          }
        }
      },
      "properties": {
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "slug": {
          "type": [
            "string",
            "null"
          ]
        },
        "visible": {
          "type": "boolean"
        },
        "brand_external_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "categories": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "primary",
            "additional"
          ],
          "properties": {
            "primary": {
              "type": [
                "string",
                "null"
              ]
            },
            "additional": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "description_html": {
          "type": [
            "string",
            "null"
          ]
        },
        "seo": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "title",
            "description",
            "keywords"
          ],
          "properties": {
            "title": {
              "type": [
                "string",
                "null"
              ]
            },
            "description": {
              "type": [
                "string",
                "null"
              ]
            },
            "keywords": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "images": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "url",
              "url_hash",
              "sort"
            ],
            "properties": {
              "url": {
                "type": "string"
              },
              "url_hash": {
                "type": "string"
              },
              "sort": {
                "type": "integer"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        },
        "feature_values": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "feature_external_id",
              "value"
            ],
            "properties": {
              "feature_external_id": {
                "type": "string"
              },
              "value": {
                "type": "string"
              }
            }
          }
        },
        "variants": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "external_id",
              "sku",
              "price",
              "stock"
            ],
            "properties": {
              "external_id": {
                "type": "string"
              },
              "sku": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "price": {
                "type": ["object", "null"],
                "additionalProperties": false,
                "required": [
                  "amount",
                  "currency"
                ],
                "properties": {
                  "amount": {
                    "type": "string"
                  },
                  "currency": {
                    "type": "string"
                  }
                }
              },
              "price_action": {
                "const": "hold"
              },
              "stock": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "source_identity": {
                "type": [
                  "object",
                  "null"
                ],
                "additionalProperties": false,
                "required": [
                  "namespace",
                  "instance",
                  "entity",
                  "id"
                ],
                "properties": {
                  "namespace": {
                    "const": "okay"
                  },
                  "instance": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
                  },
                  "entity": {
                    "const": "variant"
                  },
                  "id": {
                    "type": "string",
                    "pattern": "^[1-9][0-9]*$"
                  }
                }
              }
            },
            "if": {
              "required": ["price_action"]
            },
            "then": {
              "required": ["source_identity"],
              "properties": {
                "price": { "type": "null" },
                "source_identity": { "type": "object" }
              }
            },
            "else": {
              "properties": {
                "price": { "type": "object" }
              }
            }
          }
        },
        "source_identity": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "namespace",
            "instance",
            "entity",
            "id"
          ],
          "properties": {
            "namespace": {
              "const": "okay"
            },
            "instance": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
            },
            "entity": {
              "const": "product"
            },
            "id": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            }
          }
        },
        "translations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "minProperties": 2,
            "required": [
              "language"
            ],
            "properties": {
              "language": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string"
              },
              "annotation_html": {
                "type": "string"
              },
              "description_html": {
                "type": "string"
              },
              "seo_title": {
                "type": "string"
              },
              "seo_description": {
                "type": "string"
              },
              "seo_keywords": {
                "type": "string"
              }
            }
          }
        },
        "documents": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "external_id",
              "title",
              "position",
              "file",
              "sha256",
              "bytes",
              "original_filename",
              "language",
              "type"
            ],
            "properties": {
              "external_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 255
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 255
              },
              "position": {
                "type": "integer",
                "minimum": 0
              },
              "file": {
                "type": "string",
                "pattern": "^document-[0-9a-f]{64}\\.pdf$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "bytes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 20971520
              },
              "original_filename": {
                "type": "string",
                "minLength": 1,
                "maxLength": 255,
                "pattern": "^[^/\\\\\\u0000]+$"
              },
              "language": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^(?:und|[a-z]{2,3}(?:-[A-Z]{2})?)$"
              },
              "type": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[a-z][a-z0-9_-]{0,63}$"
              }
            }
          }
        }
      }
    }
  }
}
