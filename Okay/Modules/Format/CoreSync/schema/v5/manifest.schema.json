{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://b2bcrm/contracts/satellite/v5/manifest.schema.json",
  "title": "Satellite snapshot manifest (v5)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "snapshot_version",
    "channel_code",
    "generated_at",
    "language",
    "currency",
    "sync_mode",
    "absent_policy",
    "counts",
    "files",
    "product_content_languages"
  ],
  "properties": {
    "feature_lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "source_instance",
        "events"
      ],
      "properties": {
        "version": {
          "const": "1.0.0"
        },
        "source_instance": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
        },
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "effective_version",
              "action",
              "source_id",
              "target_id",
              "option_map"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[1-9][0-9]*$"
              },
              "effective_version": {
                "type": "integer",
                "minimum": 1
              },
              "action": {
                "enum": [
                  "merge",
                  "retire"
                ]
              },
              "source_id": {
                "type": "string",
                "pattern": "^[1-9][0-9]*$"
              },
              "target_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[1-9][0-9]*$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "option_map": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "source_id",
                    "target_id"
                  ],
                  "properties": {
                    "source_id": {
                      "type": "string",
                      "pattern": "^[1-9][0-9]*$"
                    },
                    "target_id": {
                      "type": "string",
                      "pattern": "^[1-9][0-9]*$"
                    }
                  }
                }
              }
            },
            "if": {
              "properties": {
                "action": {
                  "const": "retire"
                }
              }
            },
            "then": {
              "properties": {
                "target_id": {
                  "type": "null"
                },
                "option_map": {
                  "maxItems": 0
                }
              }
            },
            "else": {
              "properties": {
                "target_id": {
                  "type": "string",
                  "pattern": "^[1-9][0-9]*$"
                }
              }
            }
          }
        }
      }
    },
    "schema_version": {
      "const": "5.0.0"
    },
    "snapshot_version": {
      "type": "integer",
      "minimum": 1
    },
    "channel_code": {
      "type": "string"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "language": {
      "type": "string"
    },
    "currency": {
      "type": "string"
    },
    "sync_mode": {
      "enum": [
        "full",
        "price_stock"
      ]
    },
    "absent_policy": {
      "enum": [
        "out_of_stock",
        "hide"
      ]
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "categories",
        "brands",
        "features",
        "products",
        "variants",
        "redirects"
      ],
      "properties": {
        "categories": {
          "type": "integer",
          "minimum": 0
        },
        "brands": {
          "type": "integer",
          "minimum": 0
        },
        "features": {
          "type": "integer",
          "minimum": 0
        },
        "products": {
          "type": "integer",
          "minimum": 0
        },
        "variants": {
          "type": "integer",
          "minimum": 0
        },
        "redirects": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "files": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "sha256",
              "bytes",
              "rows"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z0-9-]+\\.ndjson\\.gz$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "bytes": {
                "type": "integer",
                "minimum": 0
              },
              "rows": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "sha256",
              "bytes",
              "rows",
              "role",
              "kind"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^document-[0-9a-f]{64}\\.pdf$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "bytes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 20971520
              },
              "rows": {
                "const": 0
              },
              "role": {
                "const": "product_document"
              },
              "kind": {
                "const": "application/pdf"
              }
            }
          }
        ]
      }
    },
    "product_content_languages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
